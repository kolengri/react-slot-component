{
  "version": "2.0.4",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "bun": ">=1.3.7"
  },
  "packageManager": "bun@1.3.7",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "bunx tsc --noEmit",
    "size": "bun run scripts/check-size.ts",
    "prepare": "bun run build"
  },
  "peerDependencies": {
    "react": ">=16"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "name": "react-slot-component",
  "author": "Grigoriy Kolenko <kolenko@me.com>",
  "repository": "kolengri/react-slot-component",
  "keywords": [
    "components",
    "composable",
    "generic",
    "layouts",
    "react",
    "rendering",
    "slots",
    "template",
    "typescript"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {}
}
